{
    "name": "@moon7/result",
    "version": "0.1.2",
    "author": "Munir Hussin <profoundseven@gmail.com>",
    "contributors": [],
    "license": "MIT",
    "description": "TypeScript Result and Maybe types for functional error handling",
    "keywords": [
        "typescript",
        "error-handling",
        "result",
        "functional",
        "monad",
        "fp",
        "async"
    ],
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/es/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./future": {
            "types": "./dist/types/future/entry.d.ts",
            "import": "./dist/es/future/entry.js",
            "require": "./dist/cjs/future/entry.js"
        },
        "./future/pipeable": {
            "types": "./dist/types/future/pipeable.d.ts",
            "import": "./dist/es/future/pipeable.js",
            "require": "./dist/cjs/future/pipeable.js"
        },
        "./maybe": {
            "types": "./dist/types/maybe/entry.d.ts",
            "import": "./dist/es/maybe/entry.js",
            "require": "./dist/cjs/maybe/entry.js"
        },
        "./maybe/pipeable": {
            "types": "./dist/types/maybe/pipeable.d.ts",
            "import": "./dist/es/maybe/pipeable.js",
            "require": "./dist/cjs/maybe/pipeable.js"
        },
        "./either": {
            "types": "./dist/types/either/entry.d.ts",
            "import": "./dist/es/either/entry.js",
            "require": "./dist/cjs/either/entry.js"
        },
        "./either/pipeable": {
            "types": "./dist/types/either/pipeable.d.ts",
            "import": "./dist/es/either/pipeable.js",
            "require": "./dist/cjs/either/pipeable.js"
        },
        "./callback": {
            "types": "./dist/types/callback/entry.d.ts",
            "import": "./dist/es/callback/entry.js",
            "require": "./dist/cjs/callback/entry.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "clean": "rimraf dist",
        "prepublishOnly": "pnpm lint-ci && pnpm test && pnpm build",
        "lint": "run-p lint:*",
        "lint:type": "tsc --noEmit",
        "lint:code": "eslint",
        "lint:format": "prettier --check \"src/**/*\" \"test/**/*\"",
        "lint:files": "ls-lint --config ../../.ls-lint.yml",
        "lint:spell": "cspell lint --no-progress --show-suggestions --show-context src/**/*.{ts,vue}",
        "lint-ci": "run-s lint-ci:*",
        "lint-ci:type": "tsc --noEmit && echo 'lint type passed!'",
        "lint-ci:code": "eslint --quiet && echo 'lint code passed!'",
        "lint-ci:format": "prettier --check --log-level error \"src/**/*\" \"test/**/*\" && echo 'lint format passed!'",
        "lint-ci:files": "ls-lint --config ../../.ls-lint.yml && echo 'lint files passed!'",
        "fix": "pnpm fix:code && pnpm fix:format",
        "fix:code": "eslint --fix",
        "fix:format": "prettier --write \"src/**/*\" \"test/**/*\"",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@ls-lint/ls-lint": "^2.3.1",
        "@moon7/config-eslint": "^0.1.5",
        "@moon7/config-vite": "^0.1.2",
        "@types/node": "^22.18.13",
        "@vitest/coverage-v8": "^3.2.4",
        "cspell": "^9.2.2",
        "eslint": "^9.39.0",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.12",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    }
}
