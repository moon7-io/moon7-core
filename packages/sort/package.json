{
    "name": "@moon7/sort",
    "version": "0.1.6",
    "author": "Munir Hussin <profoundseven@gmail.com>",
    "contributors": [],
    "license": "MIT",
    "description": "Composable sorting functions for arrays and collections in JavaScript and TypeScript.",
    "keywords": [
        "sorting",
        "comparator",
        "functional",
        "composition",
        "natural-sort",
        "array",
        "typescript",
        "ascending",
        "descending",
        "order"
    ],
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.umd.cjs"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "clean": "rimraf dist",
        "prepublishOnly": "pnpm lint-ci && pnpm test && pnpm build",
        "lint": "run-p lint:*",
        "lint:type": "tsc --noEmit",
        "lint:code": "eslint",
        "lint:format": "prettier --check \"src/**/*\" \"test/**/*\"",
        "lint:files": "ls-lint --config ../../.ls-lint.yml",
        "lint:spell": "cspell lint --no-progress --show-suggestions --show-context src/**/*.{ts,vue}",
        "lint-ci": "run-s lint-ci:*",
        "lint-ci:type": "tsc --noEmit && echo 'lint type passed!'",
        "lint-ci:code": "eslint --quiet && echo 'lint code passed!'",
        "lint-ci:format": "prettier --check --log-level error \"src/**/*\" \"test/**/*\" && echo 'lint format passed!'",
        "lint-ci:files": "ls-lint --config ../../.ls-lint.yml && echo 'lint files passed!'",
        "fix": "pnpm fix:code && pnpm fix:format",
        "fix:code": "eslint --fix",
        "fix:format": "prettier --write \"src/**/*\" \"test/**/*\"",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "benchmark": "pnpm test sort && pnpm benchmark:sorter",
        "benchmark:sorter": "vite-node benchmarks/sorting.bench.ts"
    },
    "devDependencies": {
        "@ls-lint/ls-lint": "^2.3.1",
        "@moon7/config-eslint": "^0.1.5",
        "@moon7/config-vite": "^0.1.2",
        "@types/node": "^22.18.13",
        "@vitest/coverage-v8": "^3.2.4",
        "cspell": "^9.2.2",
        "eslint": "^9.39.0",
        "mitata": "^1.0.34",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.12",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    }
}
